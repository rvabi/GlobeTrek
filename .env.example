# Backend Render environment variables. Set values in Render, not in Git.
ConnectionStrings__DefaultConnection="Server=YOUR_AIVEN_HOST;Port=YOUR_AIVEN_PORT;Database=globetrek_db;User ID=YOUR_AIVEN_USER;Password=YOUR_AIVEN_PASSWORD;SslMode=VerifyFull;SslCa=/etc/secrets/aiven-ca.pem"
Jwt__Key=GENERATE_A_SEPARATE_RANDOM_PRODUCTION_KEY
Jwt__Issuer=GlobeTrek.Api
Jwt__Audience=GlobeTrek.Client
Cors__AllowedOrigins__2=https://YOUR_FRONTEND.onrender.com
ASPNETCORE_ENVIRONMENT=Production

# Frontend Render static-site build variable (public URL, not a secret).
GLOBETREK_API_BASE_URL=https://YOUR_BACKEND.onrender.com/api
