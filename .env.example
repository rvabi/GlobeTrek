# Backend MonsterASP.NET environment variables. Set values in the hosting panel, not in Git.
ConnectionStrings__DefaultConnection="Server=YOUR_AIVEN_HOST;Port=YOUR_AIVEN_PORT;Database=globetrek_db;User ID=YOUR_AIVEN_USER;Password=YOUR_AIVEN_PASSWORD;SslMode=VerifyFull;SslCa=D:\Sites\YOUR_SITE_ID\private\aiven-ca.pem"
Jwt__Key=GENERATE_A_SEPARATE_RANDOM_PRODUCTION_KEY
Jwt__Issuer=GlobeTrek.Api
Jwt__Audience=GlobeTrek.Client
Cors__AllowedOrigins__2=https://YOUR_FRONTEND.pages.dev
ASPNETCORE_ENVIRONMENT=Production
